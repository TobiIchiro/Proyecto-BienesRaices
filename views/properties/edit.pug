extends ../layout/admin

block styles 
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block content
    div.py-10
        h1.text-4xl.my-10.font-extrabold.text-center Bienes
            span.font-normal Raices
        h2.text-center.text-2xl.font-extrabold= pagina
        if errors
            div(class="max-w-md mx-auto my-10")
                each error in errors
                    p(class="bg-red-600 text-white uppercase text-xs text-center p-2 mb-1 font-bold")=error.msg
        div(class= "bg-white shadow py-8 px-4 rounded mx-auto mx-w-4xl my-10 md:px-10")
            form(class= "space-y-8" method= "POST" action="/my-properties/edit")
                input(type="hidden" name="_csrf" value=csrfToken)
                div(class= "space-y-5")
                    h3(class="text-lg leading-6 font-medium text-gray-900") Informacion General
                    p(class= "text-gray-600") Añade Información sobre la propiedad en venta
                    div
                        label(class= "block text-sm uppercase text-gray-500 mb-2 font-bold" for= "title") Titulo de la propiedad
                        input(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.title) ? 'border-red-500' : 'border-gray-400') id="title" placeholder="Titulo de la propiedad, ej. Casa en la Playa" type="text" name="title" value= datos.title ? datos.title : '')
                    div
                        label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="description") Descripción
                        textarea(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.description) ? 'border-red-500' : 'border-gray-400') id= "description" placeholder="Descripción de la propiedad" name="description")= datos.description ? datos.description : ''

                    div(class= "md:flex md:gap-4 space-y-5 md:space-y-0")
                        div(class= "md:w-1/2")
                            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="category") Categoria
                            select(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.category) ? 'border-red-500' : 'border-gray-400') id= "category" name="category")
                                option(value= "") - Selección -
                                each category in categories
                                    option(value=category.id selected= datos.categoryId ? (datos.categoryId == category.id ? true : false) : null)= category.name 
                        div(class= "md:w-1/2")
                            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="price") Precio
                            select(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.price) ? 'border-red-500' : 'border-gray-400') id= "price" name="price")
                                option(value= "") - Selección -
                                each price in prices
                                    option(value=price.id selected= datos.priceId ? (datos.priceId == price.id ? true : false) : null)= price.name 
                    
                    div(class= "md:flex md:gap-4 space-y-5 md:space-y-0")
                        div(class= "md:w-1/3")
                            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="rooms") Habitaciones
                            select(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.rooms) ? 'border-red-500' : 'border-gray-400') id= "rooms" name="rooms")
                                option(value= "") - Selección -
                                - var n = 1;
                                    while n < 6
                                        option(value= n selected= datos.rooms ? (datos.rooms == n ? true : false) : null) #{n++}
                        div(class= "md:w-1/3")
                            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="parking") Estacionamiento
                            select(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.parking) ? 'border-red-500' : 'border-gray-400') id= "parking" name="parking")
                                option(value= "") - Selección -
                                - var n = 1;
                                    while n < 4
                                        option(value= n selected= datos.parking ? (datos.parking == n ? true : false) : null) #{n++}
                        div(class= "md:w-1/3")
                            label.block.text-sm.uppercase.text-gray-500.mb-2.font-bold(for="wc") Baños
                            select(class= "w-full px-3 py-2 border rounded-md placeholder-gray-400 " + ((errors && !datos.wc) ? 'border-red-500' : 'border-gray-400') id= "wc" name="wc")
                                option(value= "") - Selección -
                                - var n = 1;
                                    while n < 5
                                        option(value= n selected= datos.wc ? (datos.wc == n ? true : false) : null) #{n++}
                    div(class= "border-gray-200 border-t py-5 space-y-5")
                        h3(class= "text-lg leading-6 font-medium text-gray-900") Ubicacion
                        p(class= "text-gray-600") Ubica la propiedad
                        #map.h-96


                        div
                            p.calle= datos.street ? datos.street : ''
                        
                        input(type="hidden" name="street" id="street" value= datos.street ? datos.street : '')
                        input(type="hidden" name="lat" id="lat" value= datos.lat ? datos.lat : '')
                        input(type="hidden" name="lng" id="lng" value= datos.lng ? datos.lng : '')

                    input(class= "w-full py-3 bg-gray-700 hover:bg-gray-800 rounded text-white font-bold uppercase cursor-pointer" type= "submit" value="Guardar cambios")

block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="https://unpkg.com/esri-leaflet@3.0.8/dist/esri-leaflet.js")
    script(src="https://unpkg.com/esri-leaflet-geocoder@2.2.13/dist/esri-leaflet-geocoder.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-geosearch/2.7.0/bundle.min.js")
    script(src="/js/map.js")