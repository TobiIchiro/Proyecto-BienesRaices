extends ../layout/admin

block styles
    meta(name= "csrf-token" content=csrfToken)
block content
    div.py-10
        h1.text-4xl.my-10.font-extrabold.text-center Bienes
            span.font-normal Raices
        h2.text-center.text-2xl.font-extrabold= pagina

        a(href='/my-properties/add' class="rounded py-2 px-10 bg-gray-500 hover:bg-gray-600 text-white text-sm font-bold text-center uppercase") Publicar propiedad

        if properties
            div(class= "bg-white shadow rounded-kg")
                ul(class= "divide-y divide-gray-400")
                    each property in properties 
                        li 
                            div(class= "p-6 w-full flex flex-col sm:flex-row sm:items-center sm:justify-between space-y-8 md:space-y-0 gap-4")
                                div(class= "sm:w-1/4 md:w-1/6")
                                    img(src= `uploads/${property.imagen.split(',')[0]}`, alt=`Imagen propiedad ${property.title}`)
                                div(class= "sm:w-2/4 md:w-3/6 lg:w-4/6 space-y-2")
                                    a(class= "block text-2xl font-extrabold text-gray-600 truncate uppercase" href= `property/${property.id}`)=property.title
                                    p(class= "text-sm text-black font-bold")= property.category.name
                                    p(class= "text-sm text-black font-bold flex items-center")
                                        svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6")
                                            path(stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z")
                                        = property.price.name
                                    a(href= `/my-messages/${property.id}` class= "text-gray-600 flex items-center")
                                        svg(xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6")
                                            path(stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75")
                                        p(class= "px-2")= `${property.messages.length} Mensajes`

                                    
                                div(class= "sm:w-1/4 md:w-2/6 lg:w-1/6 flex flex-col lg:flex-row gap-2")
                                    button(type="button" data-property-id= `${property.id}` class= `change-state w-full px-2 py-2 md:py-1 text-xs leading-5 font-semibold rounded-md cursor-pointer ${property.published ? 'bg-green-100 text-gray-800' : 'bg-yellow-100 text-gray-800'}`)= `${property.published ? 'Publicada': 'No publicada'}`
                                    a(href= `/my-properties/edit/${property.id}` class= "w-full px-2 py-2 md:py-1 text-xs leading-5 font-semibold rounded-md cursor-pointer bg-gray-100 text-gray-800 text-center") Editar

                                    form(method= "POST" action=`/my-properties/delete/${property.id}`)
                                        input(type="hidden" name="_csrf" value=csrfToken)
                                        input(type="submit" class= 'w-full px-2 py-2 md:py-1 text-xs leading-5 font-semibold rounded-md cursor-pointer bg-red-100 text-red-800' value= 'Eliminar')
                                
                div(class= "flex-1 flex justify-between sm:hidden")
                    a(href=`my-properties?pag=${pag-1}` class= `${pag === "1" ? 'pointer-events-none' : '' } ` + "relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50") Anterior
                    
                    a(href=`my-properties?pag=${pag + 1}` class= `${pag == pages ? 'pointer-events-none' : '' } ` + "relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50") Siguiente
                div(class= "bg-white px-4 py-3 flex items-center justify-between border-t border-gray-200 sm:px-6")
                    div(class= "hidden sm:flex-1 sm:flex sm:items-center sm:justify-between")
                        p(class= "text-sm text-gray-700 gap-2") Mostrando 
                            span(class= "font-medium") #{offset + 1} a 
                            span(class= "font-medium") #{total < limit + offset ? total : limit + offset} de 
                            span(class= "font-medium") #{total} de resultados
                    div(class= "hidden sm:block")
                        nav(class= "relative z-0 inline-flex rounded-md shadow-md")
                            - var n = 1;
                                while n <= pages
                                    a(href= `my-properties?pag=${n}` class= `${pag == n ? 'bg-gray-50 border-gray-500 text-gray-800' : 'bg-white text-gray-500 hover:bg-gray-50' } relative inline-flex items-center px-4 py-2 border text-sm font-medium`) #{n++}
        else 
            p(class= "text-center") No hay propiedades

block scripts
    script(src='/js/changeState.js')
    script(src='/js/hamburgerMenu.js')